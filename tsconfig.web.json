{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    "paths": {
      "@bitgrain/core/*": ["./src/renderer/packages/core/*"],
      "@bitgrain/api/*": ["./src/renderer/packages/api/*"],
      "@bitgrain/ui/*": ["./src/renderer/packages/ui/*"],
      "@bitgrain/engine/*": ["./src/renderer/packages/engine/*"],
      "@bitgrain/studio-core/*": ["./src/renderer/packages/studio-core/*"],
      "@bitgrain/platform/*": ["./src/renderer/packages/platform/*"],
      "@bitgrain/darkroom/*": ["./src/renderer/packages/darkroom/*"],
      "@bitgrain/studio/*": ["./src/renderer/packages/studio/*"],
      "@bitgrain/video/*": ["./src/renderer/modules/video/*"]
    }
  },
  "include": ["src/renderer", "src/shared"]
}
